{
  "expo": {
    "name": "BSPLIC 2.0",
    "slug": "bsplic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bsplic",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "pl.bsplic.app",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:bsplic.vercel.app"
      ]
    },
    "android": {
      "package": "pl.bsplic.app",
      "adaptiveIcon": {
        "backgroundColor": "#ED1224",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "bsplic.vercel.app",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#090005",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "BSPLIC potrzebuje dostępu do zdjęć, aby ustawić avatar i dodać zdjęcie do posta.",
          "cameraPermission": "BSPLIC potrzebuje dostępu do aparatu, aby zrobić zdjęcie profilowe lub dodać zdjęcie do posta."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "BSPLIC potrzebuje dostępu do aparatu, aby zrobić zdjęcie profilowe lub dodać zdjęcie do posta."
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
